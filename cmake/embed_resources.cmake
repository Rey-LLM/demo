# Converts runtime resources (shaders, config, coastlines, replay capture)
# into C++ headers of constexpr byte arrays plus one index translation unit,
# so the ftviz binary needs no files next to it.
#
#   cmake -DROOT=<source dir> -DOUT_DIR=<dir> -DLIST_FILE=<file> -P embed_resources.cmake
#
# LIST_FILE holds one path per line, relative to ROOT.
#
# Writes <OUT_DIR>/embedded/<n>.hpp (one array per file) and
# <OUT_DIR>/embedded_index.cpp (path -> bytes table, see src/core/embedded_fs.hpp).
# A header is only rewritten when its content changes, so an untouched asset
# never triggers a recompile.

cmake_minimum_required(VERSION 3.20)

if(NOT ROOT OR NOT OUT_DIR OR NOT LIST_FILE)
  message(FATAL_ERROR "embed_resources.cmake: ROOT, OUT_DIR and LIST_FILE are required")
endif()
file(STRINGS "${LIST_FILE}" FILES)

file(MAKE_DIRECTORY "${OUT_DIR}/embedded")

# 16 bytes (32 hex digits) per source line keeps every line short for all compilers.
set(_hex2 "[0-9a-f][0-9a-f]")
set(_line "")
foreach(_i RANGE 1 16)
  string(APPEND _line "${_hex2}")
endforeach()

set(_includes "")
set(_entries "")
set(_index 0)
foreach(_rel IN LISTS FILES)
  set(_src "${ROOT}/${_rel}")
  if(NOT EXISTS "${_src}")
    message(FATAL_ERROR "embed_resources.cmake: missing ${_src}")
  endif()
  file(SIZE "${_src}" _size)
  file(READ "${_src}" _hex HEX)
  string(REGEX REPLACE "(${_line})" "\\1\n" _hex "${_hex}")
  string(REGEX REPLACE "(${_hex2})" "0x\\1," _hex "${_hex}")
  set(_name "kEmbedded${_index}")
  set(_hdr "${OUT_DIR}/embedded/res_${_index}.hpp")
  set(_text "// Generated by cmake/embed_resources.cmake from ${_rel}. Do not edit.\n#pragma once\n\nnamespace ftv::embedded {\n// ${_rel} (${_size} bytes; one trailing 0 so text can be used in place)\ninline constexpr unsigned char ${_name}[] = {\n${_hex}0x00};\n}  // namespace ftv::embedded\n")
  set(_old "")
  if(EXISTS "${_hdr}")
    file(READ "${_hdr}" _old)
  endif()
  if(NOT _old STREQUAL _text)
    file(WRITE "${_hdr}" "${_text}")
  endif()
  string(APPEND _includes "#include \"embedded/res_${_index}.hpp\"\n")
  string(APPEND _entries "    {\"${_rel}\", embedded::${_name}, ${_size}u},\n")
  math(EXPR _index "${_index} + 1")
endforeach()

set(_cpp "// Generated by cmake/embed_resources.cmake. Do not edit.\n#include \"core/embedded_fs.hpp\"\n\n${_includes}\nnamespace ftv {\n\nnamespace {\nconstexpr EmbeddedFile kFiles[] = {\n${_entries}};\n}  // namespace\n\nstd::span<const EmbeddedFile> embedded_files() noexcept { return kFiles; }\n\n}  // namespace ftv\n")
set(_old "")
if(EXISTS "${OUT_DIR}/embedded_index.cpp")
  file(READ "${OUT_DIR}/embedded_index.cpp" _old)
endif()
if(NOT _old STREQUAL _cpp)
  file(WRITE "${OUT_DIR}/embedded_index.cpp" "${_cpp}")
endif()
