    "SA": "LONDON", "ZA": "LONDON", "NG": "LONDON", "EU": "LONDON", "EMEA": "LONDON",

    "DE": "FRANKFURT", "AT": "FRANKFURT", "NL": "FRANKFURT", "LU": "FRANKFURT", "PL": "FRANKFURT",
