{
  // Macro-hub taxonomy for ftviz. Each hub has two placements:
  //  * a layout anchor for the force solver. Hubs without an "anchor" get the
  //    default arrangement: FIAT_CENTER hubs on a ring of radius
  //    fiat_ring_radius at y=0, CHAIN_CLOUD hubs on an elevated ring
  //    (y = chain_ring_height), phase-offset half a fiat step, and the
  //    FALLBACK hub below the centre;
  //  * a globe placement for rendering: "lat"/"lon" in degrees and
  //    "footprint_deg", the angular radius of the hub's disc of nodes.
  //    "label_side" (east, west, north, south; default east) moves the label
  //    off a crowded neighbour.
  //    Fiat centres use their city's coordinates. Chain and fallback hubs
  //    have no geography; they are pinned to fixed points in open ocean.
  "layout": {
    "fiat_ring_radius": 1000,
    "fiat_phase_deg": 90,
    "chain_ring_radius": 700,
    "chain_ring_height": 600,
    "chain_phase_deg": -1,
    "fallback_height": -600,

    "theta": 0.8,
    "leaf_size": 16,
    "softening": 1.0,
    "cross_hub_repulsion": 0.05,
    "fill_fraction": 0.8,
    "core_gravity_ratio": 0.25,
    "anchor_inner": 0.6,
    "anchor_outer": 1.2,
    "spring_k": 0.004,
    "spring_rest_base": 10.0,
    "spring_rest_min": 1.5,
    "spring_rest_max": 14.0,
    "inter_hub_spring_scale": 0.1,
    "damping": 0.85,
    "dt": 1.0,
    "initial_temperature": 30.0,
    "cooling": 0.995,
    "min_temperature": 0.02,
    "convergence_epsilon": 0.03,
    "convergence_window": 30
  },

  "hubs": [
    { "id": "NEW_YORK",   "display_name": "New York",   "type": "FIAT_CENTER", "radius": 230, "lat": 40.71, "lon": -74.01, "footprint_deg": 3.0, "k_anchor": 0.02 },
    { "id": "LONDON",     "display_name": "London",     "type": "FIAT_CENTER", "radius": 220, "lat": 51.51, "lon": -0.13, "footprint_deg": 2.0, "label_side": "west", "k_anchor": 0.02 },
    { "id": "FRANKFURT",  "display_name": "Frankfurt",  "type": "FIAT_CENTER", "radius": 170, "lat": 50.11, "lon": 8.68, "footprint_deg": 1.4, "k_anchor": 0.02 },
    { "id": "ZURICH",     "display_name": "Zurich",     "type": "FIAT_CENTER", "radius": 140, "lat": 47.37, "lon": 8.54, "footprint_deg": 1.1, "k_anchor": 0.02 },
    { "id": "TOKYO",      "display_name": "Tokyo",      "type": "FIAT_CENTER", "radius": 210, "lat": 35.68, "lon": 139.69, "footprint_deg": 3.0, "k_anchor": 0.02 },
    { "id": "SINGAPORE",  "display_name": "Singapore",  "type": "FIAT_CENTER", "radius": 170, "lat": 1.35, "lon": 103.82, "footprint_deg": 2.6, "k_anchor": 0.02 },
    { "id": "HONG_KONG",  "display_name": "Hong Kong",  "type": "FIAT_CENTER", "radius": 160, "lat": 22.32, "lon": 114.17, "footprint_deg": 2.4, "k_anchor": 0.02 },

    { "id": "BLOCKCHAIN_ETH",  "display_name": "Ethereum", "type": "CHAIN_CLOUD", "chain": "ETH",  "radius": 200, "lat": 36.0, "lon": -42.0, "footprint_deg": 4.0, "k_anchor": 0.02 },
    { "id": "BLOCKCHAIN_BTC",  "display_name": "Bitcoin",  "type": "CHAIN_CLOUD", "chain": "BTC",  "radius": 180, "lat": 24.0, "lon": -158.0, "footprint_deg": 4.0, "k_anchor": 0.02 },
    { "id": "BLOCKCHAIN_SOL",  "display_name": "Solana",   "type": "CHAIN_CLOUD", "chain": "SOL",  "radius": 160, "lat": -22.0, "lon": 72.0, "footprint_deg": 3.5, "k_anchor": 0.02 },
    { "id": "BLOCKCHAIN_TRON", "display_name": "Tron",     "type": "CHAIN_CLOUD", "chain": "TRON", "radius": 150, "lat": -28.0, "lon": -18.0, "footprint_deg": 3.5, "k_anchor": 0.02 },

    { "id": "OFFSHORE_UNRESOLVED", "display_name": "Offshore / unresolved", "type": "FALLBACK", "radius": 170, "lat": -34.0, "lon": -118.0, "footprint_deg": 3.5, "k_anchor": 0.02 }
  ],

  // Jurisdiction -> hub. Unlisted or empty jurisdictions fall back to
  // OFFSHORE_UNRESOLVED. Region aliases (LATAM, EU, EMEA, APAC) are accepted.
  "jurisdictions": {
    "US": "NEW_YORK", "CA": "NEW_YORK", "MX": "NEW_YORK", "BR": "NEW_YORK", "AR": "NEW_YORK",
    "CL": "NEW_YORK", "CO": "NEW_YORK", "PE": "NEW_YORK", "LATAM": "NEW_YORK", "NA": "NEW_YORK",

    "GB": "LONDON", "IE": "LONDON", "FR": "LONDON", "ES": "LONDON", "PT": "LONDON", "IT": "LONDON",
    "BE": "LONDON", "SE": "LONDON", "NO": "LONDON", "DK": "LONDON", "FI": "LONDON", "AE": "LONDON",
    "SA": "LONDON", "ZA": "LONDON", "NG": "LONDON", "EU": "LONDON", "EMEA": "LONDON",

    "DE": "FRANKFURT", "AT": "FRANKFURT", "NL": "FRANKFURT", "LU": "FRANKFURT", "PL": "FRANKFURT",
    "CZ": "FRANKFURT", "HU": "FRANKFURT",

    "CH": "ZURICH", "LI": "ZURICH", "MC": "ZURICH",

    "JP": "TOKYO", "KR": "TOKYO", "TW": "TOKYO", "APAC": "TOKYO",

    "SG": "SINGAPORE", "MY": "SINGAPORE", "ID": "SINGAPORE", "TH": "SINGAPORE", "VN": "SINGAPORE",
    "PH": "SINGAPORE", "IN": "SINGAPORE", "AU": "SINGAPORE", "NZ": "SINGAPORE",

    "HK": "HONG_KONG", "CN": "HONG_KONG", "MO": "HONG_KONG"
  }
}
