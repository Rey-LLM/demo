{
  // Public, zero-auth, documented endpoints only. TLS verification is always
  // on. Rate limits are recorded with their sources in DESIGN_NOTES.md §11.
  //
  // label: what a message from this feed is when it arrives (LIVE, or
  //   DELAYED for data fetched behind the tip). A feed that falls back to the
  //   bundled capture is shown as REPLAY instead, wherever it appears.
  // whale_usd: single events at or above this USD value become whale events
  //   (tier 2 at 3x, tier 3 at 10x).
  "fallback_after_s": 15,        // OFFLINE or RATE_LIMITED this long -> REPLAY of the capture ...
  "fallback_policy": "all_offline",  // ... but only while no feed is LIVE ("per_feed": each feed on its own)
  "stale_after_s": 30,           // LIVE but silent this long -> DEGRADED, then reconnect
  "max_frame_bytes": 8388608,    // 8 MB
  // Flow trails: hub-to-hub trades and transfers worth at least this much
  // are drawn as dim deep-amber arcs (at most trail_max_per_s new ones per
  // second); whales (whale_usd per feed) burn brighter and hotter.
  "trail_min_usd": 2500,
  "trail_max_per_s": 40,
  "backoff_base_s": 0.5,
  "backoff_cap_s": 30,
  "replay_capture": "assets/replay/default.ftxcap",

  // Fiat quote currency -> hub that stands for its home market (a display
  // convention for exchange trades; documented in the README).
  // USDT (Binance quotes) tracks the US dollar, so it is drawn to New York too.
  "quote_hubs": { "USD": "NEW_YORK", "USDT": "NEW_YORK", "EUR": "FRANKFURT", "GBP": "LONDON", "JPY": "TOKYO", "HKD": "HONG_KONG" },
  "chain_hubs": { "BTC": "BLOCKCHAIN_BTC", "ETH": "BLOCKCHAIN_ETH", "SOL": "BLOCKCHAIN_SOL" },

  "feeds": [
    {
      "id": "BTC", "enabled": true, "label": "LIVE",
      "url": "wss://ws.blockchain.info/inv",
      "docs": "https://www.blockchain.com/explorer/api/api_websocket",
      "subscribe": ["{\"op\":\"unconfirmed_sub\"}"],
      "whale_usd": 1000000
    },
    {
      "id": "BTC_BLOCKS", "enabled": true, "label": "LIVE",
      "url": "wss://mempool.space/api/v1/ws",
      "docs": "https://mempool.space/docs/api/websocket",
      "subscribe": ["{\"action\":\"want\",\"data\":[\"blocks\"]}"],
      "whale_usd": 0
    },
    {
      // Ordered endpoint pool: one endpoint active at a time, each with its own
      // token bucket at or below the provider's published per-IP limit
      // (DESIGN_NOTES "RPC endpoint pools"). Rotation only on a provider error
      // or 429, never to get more throughput. "limit" quotes the provider;
      // where no number is published the budget is a conservative 1-2 req/s.
      "id": "ETH", "enabled": true, "label": "LIVE",
      "docs": "https://ethereum.org/en/developers/docs/apis/json-rpc/",
      "try_pending": true,
      "pool": [
        { "url": "wss://ethereum-rpc.publicnode.com", "max_requests_per_s": 2, "pending_tx": true,
          "limit": "not published as a number (fair-use)", "limit_source": "https://ethereum-rpc.publicnode.com",
          "as_of": "UNVERIFIED" },
        { "url": "wss://eth.drpc.org", "max_requests_per_s": 2, "pending_tx": false,
          "limit": "free public tier, per-IP limits apply", "limit_source": "https://drpc.org/docs/howitworks/ratelimiting",
          "as_of": "UNVERIFIED" },
        { "url": "wss://mainnet.gateway.tenderly.co", "max_requests_per_s": 1, "pending_tx": false,
          "limit": "public gateway, rate limited", "limit_source": "https://docs.tenderly.co/node/rpc-reference/ethereum-mainnet",
          "as_of": "UNVERIFIED" }
      ],
      "whale_usd": 1000000
    },
    {
      // getBlock follow-ups go to the active endpoint's rpc_url over HTTPS.
      "id": "SOL", "enabled": true, "label": "DELAYED",
      "docs": "https://solana.com/docs/rpc",
      "slot_lag": 32,
      "sample_cap": 32,
      "pool": [
        { "url": "wss://api.mainnet-beta.solana.com", "rpc_url": "https://api.mainnet-beta.solana.com",
          "max_requests_per_s": 3,
          "limit": "100 requests / 10 s per IP; 40 / 10 s per IP for a single RPC method",
          "limit_source": "https://solana.com/docs/references/clusters", "as_of": "UNVERIFIED" },
        { "url": "wss://solana-rpc.publicnode.com", "rpc_url": "https://solana-rpc.publicnode.com",
          "max_requests_per_s": 2,
          "limit": "not published as a number (fair-use)", "limit_source": "https://solana-rpc.publicnode.com",
          "as_of": "UNVERIFIED" },
        { "url": "wss://solana.drpc.org", "rpc_url": "https://solana.drpc.org", "max_requests_per_s": 2,
          "limit": "free public tier, per-IP limits apply", "limit_source": "https://drpc.org/docs/howitworks/ratelimiting",
          "as_of": "UNVERIFIED" }
      ],
      "whale_usd": 250000
    },
    {
      "id": "COINBASE", "enabled": true, "label": "LIVE",
      "url": "wss://ws-feed.exchange.coinbase.com",
      "docs": "https://docs.cdp.coinbase.com/exchange/docs/websocket-channels",
      "subscribe": ["{\"type\":\"subscribe\",\"product_ids\":[\"BTC-USD\",\"ETH-USD\",\"SOL-USD\",\"BTC-EUR\",\"ETH-EUR\",\"BTC-GBP\",\"ETH-GBP\"],\"channels\":[\"matches\",\"ticker\",\"heartbeat\"]}"],
      "whale_usd": 250000
    },
    {
      "id": "KRAKEN", "enabled": true, "label": "LIVE",
      "url": "wss://ws.kraken.com/v2",
      "docs": "https://docs.kraken.com/api/docs/websocket-v2/trade",
      "subscribe": [
        "{\"method\":\"subscribe\",\"params\":{\"channel\":\"trade\",\"symbol\":[\"BTC/USD\",\"ETH/USD\",\"SOL/USD\",\"BTC/EUR\",\"ETH/EUR\",\"BTC/GBP\",\"BTC/JPY\"],\"snapshot\":false}}",
        "{\"method\":\"subscribe\",\"params\":{\"channel\":\"ticker\",\"symbol\":[\"BTC/USD\",\"ETH/USD\",\"SOL/USD\",\"BTC/EUR\",\"ETH/EUR\",\"BTC/GBP\",\"BTC/JPY\",\"USDT/USD\"]}}"
      ],
      "whale_usd": 250000
    },
    {
      // Aggregate trades, combined stream: no subscribe message needed.
      // stream.binance.com answers HTTP 451 in restricted regions (e.g. the
      // US); data-stream.binance.vision is Binance's market-data-only host.
      "id": "BINANCE", "enabled": true, "label": "LIVE",
      "url": "wss://stream.binance.com:9443/stream?streams=btcusdt@aggTrade/ethusdt@aggTrade/solusdt@aggTrade/btceur@aggTrade/etheur@aggTrade",
      "fallback_urls": [
        "wss://stream.binance.com:443/stream?streams=btcusdt@aggTrade/ethusdt@aggTrade/solusdt@aggTrade/btceur@aggTrade/etheur@aggTrade",
        "wss://data-stream.binance.vision/stream?streams=btcusdt@aggTrade/ethusdt@aggTrade/solusdt@aggTrade/btceur@aggTrade/etheur@aggTrade"
      ],
      "docs": "https://developers.binance.com/docs/binance-spot-api-docs/web-socket-streams",
      "whale_usd": 250000
    },
    {
      // Binance USD-M futures liquidation orders (all symbols, one stream;
      // BTC, ETH and SOL ones are valued, the rest counted). Same 451 rule
      // as spot: restricted regions show GEO_BLOCKED.
      "id": "BINANCE_LIQ", "enabled": true, "label": "LIVE",
      "url": "wss://fstream.binance.com/ws/!forceOrder@arr",
      "docs": "https://developers.binance.com/docs/derivatives/usds-margined-futures/websocket-market-streams/All-Market-Liquidation-Order-Streams",
      "whale_usd": 1000000,
      "tape_min_usd": 25000
    },
    {
      // OKX public channel: spot trades and swap liquidation orders. Contract
      // sizes come from the public instruments endpoint at connect; OKX
      // closes idle connections after 30 s, so "ping" is sent after 20 s.
      "id": "OKX", "enabled": true, "label": "LIVE",
      "url": "wss://ws.okx.com:8443/ws/v5/public",
      "meta_url": "https://www.okx.com/api/v5/public/instruments?instType=SWAP",
      "docs": "https://www.okx.com/docs-v5/en/#public-data-websocket-trades-channel",
      "subscribe": ["{\"op\":\"subscribe\",\"args\":[{\"channel\":\"trades\",\"instId\":\"BTC-USDT\"},{\"channel\":\"trades\",\"instId\":\"ETH-USDT\"},{\"channel\":\"trades\",\"instId\":\"SOL-USDT\"},{\"channel\":\"trades\",\"instId\":\"BTC-USD\"},{\"channel\":\"liquidation-orders\",\"instType\":\"SWAP\"}]}"],
      "ping": "ping", "ping_s": 20,
      "whale_usd": 250000,
      "tape_min_usd": 25000
    },
    {
      // ECB euro reference rates (published once per working day, ~16:00 CET)
      // re-based to USD by Frankfurter. Prices only: no arcs come from this feed.
      "id": "FX", "enabled": true, "label": "DELAYED",
      "url": "https://api.frankfurter.dev/v1/latest?base=USD&symbols=EUR,GBP,JPY,CNY,HKD",
      "fallback_urls": ["https://api.frankfurter.app/latest?from=USD&to=EUR,GBP,JPY,CNY,HKD"],
      "docs": "https://frankfurter.dev",
      "poll_s": 900,
      "whale_usd": 0
    }
  ],

  // Fiat corridors are never observed: they are MODELED from published
  // aggregates (config/flows_baseline.csv) and labelled MODELED everywhere.
  "fiat_model": { "enabled": true, "baseline": "config/flows_baseline.csv" }
}
